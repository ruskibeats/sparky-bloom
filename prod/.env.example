# ============================================
# SparkyFitness — Required Environment Variables
# ============================================
# Copy this to .env and fill in values
# cp .env.example .env

# --- Database ---
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_HOST=sparkyfitness-db
SPARKY_FITNESS_DB_NAME=sparkyfitness
SPARKY_FITNESS_DB_PASSWORD=change-me
SPARKY_FITNESS_DB_PORT=5432
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=change-me-too

# --- Server ---
SPARKY_FITNESS_SERVER_PORT=3010
SPARKY_FITNESS_FRONTEND_URL=http://localhost:3000
SPARKY_FITNESS_LOG_LEVEL=info
SPARKY_FITNESS_PUBLIC_API_DOCS=true
SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS=
ALLOW_PRIVATE_NETWORK_CORS=true

# --- Secrets (generate your own) ---
# Generate with: openssl rand -base64 32
SPARKY_FITNESS_SECRET_KEY=replace-with-random-secret
SPARKY_FITNESS_ENCRYPTION_KEY=replace-with-random-32-char-key

# --- Auth (better-auth) ---
BETTER_AUTH_URL=http://localhost:3010
BETTER_AUTH_SECRET=replace-with-random-secret

# --- External APIs (optional — leave blank to disable) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
USDA_API_KEY=
OPEN_FOOD_FACTS_APP_NAME=sparky-fitness
OPEN_FOOD_FACTS_APP_VERSION=1.0

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sparkyfitness.local